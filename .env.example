# ============================================
# KAVACHGRID 3.0 — Environment Variables
# Copy this file to .env and fill in values
# ============================================

# ---------- PostgreSQL ----------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=kavachgrid
POSTGRES_USER=kavach_admin
POSTGRES_PASSWORD=change_me_in_production

# ---------- FastAPI Backend ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=generate-a-secure-random-key-here
API_KEY=kavach-device-api-key-change-me
DEBUG=true
LOG_LEVEL=INFO

# ---------- MQTT Broker ----------
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
MQTT_BROKER_TLS_PORT=8883
MQTT_USERNAME=kavachgrid
MQTT_PASSWORD=change_me_in_production
MQTT_KEEPALIVE=60

# ---------- AI Engine ----------
AI_MODEL_PATH=/app/ai/models/autoencoder_v1.h5
ANOMALY_THRESHOLD=0.5

# ---------- Risk Engine ----------
ENERGY_BALANCE_WEIGHT=0.30
AI_ANOMALY_WEIGHT=0.25
METER_HEALTH_WEIGHT=0.20
DEVICE_TRUST_WEIGHT=0.15
COMM_RELIABILITY_WEIGHT=0.10

# ---------- Dashboard ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ---------- General ----------
TZ=Asia/Kolkata
